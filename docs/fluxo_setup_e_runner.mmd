    EF1(["FALHA DE INICIALIZAÇÃO"])
    OK(["Resposta de sucesso<br/>para o Automation Anywhere"])
    EF2(["Falha na execução<br/>para o Automation Anywhere"])

    E0 --> E1 --> D4
