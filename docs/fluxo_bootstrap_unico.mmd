    D5 -- "Sim" --> POK
  end

  subgraph EXEC["2. EXECUÇÃO E RETORNO"]
    direction TB
    E0["Bootstrap extrai e repassa<br/>somente parametros"]
    E1["Inicia main.py<br/>no venv preparado"]
    E2["Automação valida os parâmetros<br/>funcionais e executa as etapas"]
